<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Outgoing network. A sandboxed macOS app cannot reach api.render.com
	     without this, and `flutter create` does not add it: the template only
	     grants network.server, for the debug tooling. Every request fails
	     without it, in release as well as debug. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
